FORGEVAULT_DATABASE_URL=postgresql+psycopg://forgevault:forgevault@localhost:5432/forgevault
FORGEVAULT_LOCAL_VAULT_ROOT=./data/vault
FORGEVAULT_STAGING_ROOT=./data/staging
FORGEVAULT_SERVICE_NAME=forgevault-api
FORGEVAULT_AUTO_CREATE_SCHEMA=false
FORGEVAULT_ENABLE_DESKTOP_BRIDGE=false
FORGEVAULT_JOBBOSS2_OUTBOX_ROOT=./data/jobboss2/outbox
# Optional integration gateway/webhook for JobBOSS² handoff; leave blank to use outbox JSON files.
# FORGEVAULT_JOBBOSS2_WEBHOOK_URL=https://example.invalid/jobboss2/release-package
# FORGEVAULT_JOBBOSS2_API_KEY=
